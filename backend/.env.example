# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables (never commit the real .env).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hello_doc
# Set to true when your hosted MySQL requires TLS (e.g. Aiven, PlanetScale via TLS)
DB_SSL=false
# Restrict CORS to your deployed origin in production, e.g. https://your-app.vercel.app
CORS_ORIGIN=*
# Local-only: where the Flask symptom app runs
FLASK_ORIGIN=http://127.0.0.1:5001

# Session and JWT secrets - generate random strings for production
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here
# JWT token expiry (e.g., 24h, 7d, 30d)
JWT_EXPIRY=24h
