# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables (never commit the real .env).

# Configure these together to use the Supabase implementation instead of legacy MySQL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Never use a Supabase secret/service-role key in browser code or routine API routes.

# Legacy MySQL is used only if Supabase is not configured.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hello_doc
# Set to true when your hosted MySQL requires TLS (e.g. Aiven, PlanetScale via TLS)
DB_SSL=false
# Public browser origin used to validate state-changing requests.
APP_ORIGIN=http://localhost:5000
# Local backend starts the private model automatically when Python dependencies are installed.
# Only set FLASK_ORIGIN and PREDICTION_INTERNAL_TOKEN together when running an external model service.
# FLASK_ORIGIN=http://127.0.0.1:5001
# PREDICTION_INTERNAL_TOKEN=

# Signed cookie secret (required in production). Use a random 32-byte value.
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_random_secret
