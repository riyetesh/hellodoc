# Copy to backend/.env for local development (gitignored). On Vercel, set these
# in Project Settings -> Environment Variables.
#
# Supabase is the only account backend. Both values are required; without them
# every /api request fails closed with 503 and only static pages are served.
SUPABASE_URL=https://your-project-ref.supabase.co
# PUBLIC browser-safe key only. A service-role or sb_secret_ key is rejected.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public browser origin used to validate state-changing requests.
APP_ORIGIN=http://localhost:5000

# Local backend starts the private model automatically when Python dependencies
# are installed: create Algo/.venv and run `pip install -r Algo/requirements.txt`.
# Only set FLASK_ORIGIN and PREDICTION_INTERNAL_TOKEN together when running an
# external model service; the local autostart generates its own shared token.
# FLASK_AUTOSTART=true
# FLASK_ORIGIN=http://127.0.0.1:5001
# PREDICTION_INTERNAL_TOKEN=

# Server-only, never loaded by a web handler and never committed. Used solely by
# the one-off `node backend/bootstrap-admin.js` first-admin script.
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_BOOTSTRAP_CONFIRM=provision-first-admin
