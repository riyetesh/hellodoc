{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "installCommand": "npm ci --prefix backend --ignore-scripts",
      "buildCommand": "node backend/build-static.js",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "production.js",
      "installCommand": "npm ci --ignore-scripts"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/admin", "destination": { "service": "web", "path": "/admin.html" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
