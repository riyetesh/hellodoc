# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables (never commit the real .env).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=user_accounts
# Set to true when your hosted MySQL requires TLS
DB_SSL=false
# Restrict CORS to your deployed origin in production
CORS_ORIGIN=*
